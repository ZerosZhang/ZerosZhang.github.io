#!/bin/sh
# pre-commit hook: 提交前自动压缩本次暂存的图片
# 安装：git config core.hooksPath .githooks

echo "[pre-commit] 压缩暂存图片..."

# 找出暂存区中新增/修改的图片（jpg/jpeg/png，忽略删除）
# core.quotepath=false: 让 git 输出真实 UTF-8 路径（而非 \346\211 转义），否则中文文件名找不到
STAGED=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACM -- '*.jpg' '*.jpeg' '*.png')

if [ -z "$STAGED" ]; then
    echo "[pre-commit] 无图片变更，跳过压缩"
    exit 0
fi

# 逐文件压缩并重新加入暂存区
# 注意：用 while ... <<EOF 在主 shell 中循环，避免管道子进程副作用
while IFS= read -r f; do
    [ -z "$f" ] && continue
    python scripts/compress_images.py --paths "$f"
    RC=$?
    if [ $RC -ne 0 ]; then
        echo "[pre-commit] 压缩脚本执行失败，提交中止"
        exit 1
    fi
    git add -- "$f" 2>/dev/null
done <<EOF
$STAGED
EOF

echo "[pre-commit] 图片压缩完成"
exit 0
